kubeProxyReplacement: true
k8sServiceHost: "{{ cp1_ip }}"
k8sServicePort: 6443
ipam:
  mode: kubernetes
operator:
  replicas: 1
devices:
  - "{{ mesh_interface }}"
l2announcements:
  enabled: true
hubble:
  relay:
    enabled: true
  ui:
    enabled: true
# cilium is also the ingress controller — one shared LB IP for all UIs
ingressController:
  enabled: true
  loadbalancerMode: shared
  default: true
  service:
    annotations:
      lbipam.cilium.io/ips: "{{ ingress_ip }}"
