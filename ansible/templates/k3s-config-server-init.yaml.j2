cluster-init: true
token: "{{ k3s_token }}"
node-ip: "{{ node_ip }}"
tls-san:
  - "{{ api_vip }}"
  - "{{ cp1_ip }}"
  # wireguard IPs — GPU agents reach the API through the tunnel
  - "10.8.0.11"
  - "10.8.0.12"
  - "10.8.0.13"
# Cilium does everything — strip k3s down
flannel-backend: none
disable-network-policy: true
disable-kube-proxy: true
disable:
  - servicelb
  - traefik
  - local-storage
